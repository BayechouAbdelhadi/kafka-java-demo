{
  "type": "record",
  "name": "OrderEventDemo",
  "namespace": "com.example.kafka.avro.demo",
  "doc": "Évolution INVALIDE sous TRANSITIVE : valide par rapport à V2 mais incompatible avec V1",
  "fields": [
    { "name": "orderId", "type": "string" },
    { "name": "customerId", "type": "string" },
    { "name": "totalAmount", "type": "string", "default": "0.0", "doc": "Type string : incompatible avec le type double initial de V1 (Avro n'autorise pas la conversion double -> string à la lecture)" },
    { "name": "currency", "type": "string", "default": "EUR" }
  ]
}
