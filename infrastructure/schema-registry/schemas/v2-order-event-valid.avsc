{
  "type": "record",
  "name": "OrderEventDemo",
  "namespace": "com.example.kafka.avro.demo",
  "doc": "Version 2 (Valide) - Ajout d'un champ avec valeur par défaut (FORWARD compatible)",
  "fields": [
    { "name": "orderId", "type": "string" },
    { "name": "customerId", "type": "string" },
    { "name": "totalAmount", "type": "double" },
    { "name": "currency", "type": "string", "default": "EUR", "doc": "Monnaie avec défaut pour lecture des anciens messages v1" }
  ]
}
