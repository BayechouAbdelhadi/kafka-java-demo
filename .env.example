# Variables d'environnement pour l'infrastructure locale Kafka & PostgreSQL
# Copier ce fichier vers .env si personnalisation nécessaire

# Configuration Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLUSTER_ID=4L62EnnTQNihNZcmdVsJ4A

# Configuration Schema Registry
SCHEMA_REGISTRY_URL=http://localhost:8081

# Configuration PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=kafka_training_db
POSTGRES_PORT=5432

# Ports des microservices Spring Boot
ORDER_SERVICE_PORT=8081
INVENTORY_SERVICE_PORT=8082
NOTIFICATION_SERVICE_PORT=8083
