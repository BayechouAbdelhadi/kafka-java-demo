{
  "type": "record",
  "name": "OrderEvent",
  "namespace": "com.example.kafka.avro",
  "doc": "Événement de cycle de vie d'une commande (Order)",
  "fields": [
    { "name": "eventId", "type": "string", "doc": "UUID unique de l'événement pour déduplication" },
    { "name": "eventType", "type": "string", "doc": "Type d'événement (ex: ORDER_CREATED, ORDER_CANCELLED)" },
    { "name": "occurredAt", "type": "long", "doc": "Timestamp epoch millisecondes de survenance" },
    { "name": "aggregateId", "type": "string", "doc": "Identifiant de l'agrégat (égal à l'orderId)" },
    { "name": "orderId", "type": "string", "doc": "Identifiant de la commande" },
    { "name": "customerId", "type": "string", "doc": "Identifiant du client" },
    { "name": "totalAmount", "type": "double", "doc": "Montant total de la commande" },
    { "name": "status", "type": "string", "doc": "Statut de la commande (ex: CREATED, CONFIRMED, REJECTED)" },
    {
      "name": "items",
      "type": {
        "type": "array",
        "items": {
          "type": "record",
          "name": "OrderItem",
          "fields": [
            { "name": "productId", "type": "string", "doc": "Identifiant du produit / SKU" },
            { "name": "quantity", "type": "int", "doc": "Quantité commandée" },
            { "name": "unitPrice", "type": "double", "doc": "Prix unitaire" }
          ]
        }
      },
      "doc": "Lignes de la commande"
    }
  ]
}
